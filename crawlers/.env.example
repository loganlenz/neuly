# Neuly Crawlers Configuration
# Copy this file to .env and fill in your values

# NCBI API Key (optional, but recommended)
# Get your key at: https://www.ncbi.nlm.nih.gov/account/settings/#accountSettingsApiKeyManagement
# Without a key: 3 requests/second
# With a key: 10 requests/second
NCBI_API_KEY=

# Logging level
# Options: debug, info, warn, error
LOG_LEVEL=info

# Data output directory (optional, defaults to ./data)
# DATA_DIR=./data

# Postgres connection string (optional)
# When set, all data is stored in Postgres instead of JSON files.
# Apply the schema with: npm run db:migrate
# DATABASE_URL=postgresql://neuly:neuly@127.0.0.1:5432/neuly

# Scheduler (npm run schedule)
# Run all crawlers immediately on startup, then follow the cron cadence
# RUN_ON_START=true
# Override per-crawler cron expressions:
# SCHEDULE_CLINICALTRIALS=0 6 * * *
# SCHEDULE_COMPANIES=0 7 * * 1-5
# SCHEDULE_JOBS=30 7 * * *
# SCHEDULE_EVENTS=0 8 * * *
# SCHEDULE_PUBMED=0 5 * * 1
# SCHEDULE_PEOPLE=0 5 * * 2

# LegiScan API key for state bill tracking (free: legiscan.com/legiscan)
# Without it, the legislation crawler still collects Federal Register documents
# LEGISCAN_API_KEY=

# Email for the OpenAlex polite pool (optional, faster + more reliable)
# OPENALEX_MAILTO=you@example.com

# ============ Product surface (Phase 3) ============
# All account features (auth, alerts, billing) require DATABASE_URL.

# Secret for signing session cookies — REQUIRED in production
# SESSION_SECRET=

# Public site URL used in SEO canonical links, sitemap, and Stripe redirects
# SITE_URL=https://neuly.io

# Email delivery via Resend (https://resend.com). Without it, emails are
# written to data/outbox/ so the pipeline still works in development.
# RESEND_API_KEY=
# MAIL_FROM="Neuly <alerts@neuly.io>"

# Stripe billing (all four required to enable checkout/webhook/portal)
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=
# STRIPE_WEBHOOK_SECRET=

# Product job cadence overrides
# SCHEDULE_ALERTS=0 12 * * *
# SCHEDULE_NEWSLETTER=0 13 * * 1

# ============ Launch: accounts, API product, admin ============
# Comma-separated emails promoted to the admin role on signup/login — the
# operator console at /admin (users, plan overrides, crawler control).
# ADMIN_EMAILS=you@yourdomain.com

# Browser origins allowed to call the API with cookies (comma separated).
# Unset = reflect any origin (fine for a same-origin deploy or local dev).
# CORS_ORIGINS=https://neuly.io,https://www.neuly.io

# Display prices on /pricing (USD per month). Stripe prices are the contract.
# PLAN_PRICE_PRO=79
# PLAN_PRICE_ENTERPRISE=499

# API quotas per UTC day (Pro and Enterprise keys); burst limits are in plans.ts
# API_QUOTA_PRO=2000
# API_QUOTA_ENTERPRISE=100000

# Anonymous / signed-in web traffic limits per minute
# ANON_RATE_LIMIT_PER_MINUTE=120
# SESSION_RATE_LIMIT_PER_MINUTE=600

# ClinicalTrials.gov incremental refresh window (days) for the hourly crawl
# CT_RECENT_DAYS=3
# How often the scheduler polls for admin-requested crawls (ms)
# CRAWL_REQUEST_POLL_MS=30000
