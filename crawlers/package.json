{
  "name": "neuly-crawlers",
  "version": "1.0.0",
  "description": "Web crawlers and API server for the Neuly psychedelic medicine research platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "server": "tsx src/server.ts",
    "server:dev": "tsx watch src/server.ts",
    "crawl:trials": "tsx src/index.ts --crawler=clinicaltrials",
    "crawl:pubmed": "tsx src/index.ts --crawler=pubmed",
    "crawl:companies": "tsx src/index.ts --crawler=companies",
    "crawl:jobs": "tsx src/index.ts --crawler=jobs",
    "crawl:events": "tsx src/index.ts --crawler=events",
    "crawl:people": "tsx src/index.ts --crawler=people",
    "crawl:all": "tsx src/index.ts --crawler=all",
    "crawl:legislation": "tsx src/index.ts --crawler=legislation",
    "crawl:funding": "tsx src/index.ts --crawler=funding",
    "crawl:preprints": "tsx src/index.ts --crawler=preprints",
    "crawl:grants": "tsx src/index.ts --crawler=grants",
    "enrich:openalex": "tsx src/index.ts --crawler=openalex",
    "schedule": "tsx src/scheduler.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/seed.ts",
    "seed:if-empty": "tsx src/seed.ts --if-empty",
    "deploy:start": "tsx src/db/migrate.ts --if-configured && npm run seed:if-empty && npm run server",
    "setup": "npm run seed && npm run server",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "keywords": [
    "crawler",
    "psychedelics",
    "research",
    "clinical-trials",
    "pubmed"
  ],
  "author": "Neuly Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^4.3.2",
    "node-cron": "^4.5.0",
    "p-limit": "^5.0.0",
    "p-retry": "^6.2.0",
    "pg": "^8.22.0",
    "tsx": "^4.6.2",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  }
}
